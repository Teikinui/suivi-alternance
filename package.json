{
  "name": "candidatures",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/api.test.js && vitest run",
    "test:api": "node --test tests/api.test.js",
    "test:ui": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "design:preview": "node tests/design-preview.mjs",
    "design:detect": "npx --yes impeccable@4.8.2 detect src/"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
